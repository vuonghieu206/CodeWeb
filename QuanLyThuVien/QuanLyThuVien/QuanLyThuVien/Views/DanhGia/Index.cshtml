@model PaginatedList<Review>
@{
    ViewData["Title"] = "Quản lý Đánh giá";
    var titles = (Dictionary<int, string>)ViewBag.Titles;
    int? rating = ViewBag.Rating as int?;
}
<div class="card mt-3">
    <div class="card-header"><h3 class="card-title mb-0">Đánh giá của độc giả</h3></div>
    <div class="card-body">
        <form method="get" action="/DanhGia" class="row g-2 mb-3">
            <div class="col-12 col-md-5">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo sách, người đánh giá, nội dung..." />
            </div>
            <div class="col-6 col-md-3">
                <select name="rating" class="form-select">
                    <option value="">-- Mọi số sao --</option>
                    @for (var i = 5; i >= 1; i--)
                    {
                        <option value="@i" selected="@(rating == i)">@i sao</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2 d-grid"><button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Lọc</button></div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Thời gian</th><th>Sách</th><th>Người đánh giá</th><th>Số sao</th><th>Bình luận</th><th style="width:70px"></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center py-3">Chưa có đánh giá nào.</td></tr>
                    }
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(titles.TryGetValue(r.BookId, out var t) ? t : "(sách đã xóa)")</td>
                            <td>@r.UserName</td>
                            <td class="text-nowrap"><span class="text-warning">@(new string('★', r.Rating))</span><span class="text-secondary">@(new string('★', 5 - r.Rating))</span></td>
                            <td style="white-space: pre-line;">@r.Comment</td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Xóa đánh giá này?');">
                                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="small text-muted mt-2">Tổng: @Model.TotalItems đánh giá</div>
        <partial name="_Pager" model="Model" />
    </div>
</div>
