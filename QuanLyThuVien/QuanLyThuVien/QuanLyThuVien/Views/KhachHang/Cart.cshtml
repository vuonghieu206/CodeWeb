@model IEnumerable<Book>
@{
    Layout = "_LayoutKhach";
    ViewData["Title"] = "Giỏ mượn";
    var reader = ViewBag.Reader as Reader;
}

<h3 class="mb-3"><i class="bi bi-basket"></i> Giỏ mượn sách</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">Giỏ mượn đang trống.</div>
    <a href="/KhachHang" class="btn btn-primary">Tiếp tục chọn sách</a>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <ul class="list-group list-group-flush">
                    @foreach (var b in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(b.CoverImage) ? "/img/book-default.svg" : b.CoverImage)" alt="" style="width:44px;height:58px;object-fit:cover;border-radius:6px;" />
                                <div>
                                    <a href="/KhachHang/Details/@b.Id" class="fw-bold text-decoration-none">@b.Title</a>
                                    <div class="small text-muted">@b.Author</div>
                                </div>
                            </div>
                            <form asp-action="RemoveFromCart" asp-route-id="@b.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa khỏi giỏ"><i class="bi bi-trash"></i></button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Thông tin người mượn</h5>
                    @if (reader != null)
                    {
                        <dl class="row mb-2">
                            <dt class="col-4">Họ tên</dt><dd class="col-8">@reader.FullName</dd>
                            <dt class="col-4">Điện thoại</dt><dd class="col-8">@reader.PhoneNumber</dd>
                            <dt class="col-4">Email</dt><dd class="col-8">@reader.Email</dd>
                        </dl>
                    }
                    <p class="small text-muted">
                        Thông tin lấy từ tài khoản của bạn. <a href="/KhachHang/TaiKhoan">Cập nhật thông tin</a>.
                        Yêu cầu sẽ được thủ thư xem xét; thời hạn mượn mặc định 14 ngày.
                    </p>
                    <form asp-action="Checkout" method="post">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send"></i> Gửi yêu cầu mượn</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
