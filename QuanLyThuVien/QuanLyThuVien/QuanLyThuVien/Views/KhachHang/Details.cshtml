@model Book
@inject Ganss.Xss.IHtmlSanitizer Sanitizer
@{
    Layout = "_LayoutKhach";
    ViewData["Title"] = Model.Title;
    var recent = (IEnumerable<Book?>)ViewBag.Recent;
    bool inCart = (bool)ViewBag.InCart;
    var reviews = (ReviewsViewModel)ViewBag.Reviews;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/KhachHang">Trang chủ</a></li>
        @if (!string.IsNullOrEmpty(Model.Category))
        {
            <li class="breadcrumb-item"><a href="/KhachHang?category=@Uri.EscapeDataString(Model.Category)">@Model.Category</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <img src="@(string.IsNullOrEmpty(Model.CoverImage) ? "/img/book-default.svg" : Model.CoverImage)"
                     alt="@Model.Title" class="img-fluid rounded shadow-sm" style="max-height:420px;" />
            </div>
            <div class="col-md-8">
                <h2 class="fw-bold">@Model.Title</h2>
                <p class="mb-1"><i class="bi bi-person"></i> <strong>Tác giả:</strong> @Model.Author</p>
                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <p class="mb-1"><i class="bi bi-tags"></i> <strong>Thể loại:</strong> @Model.Category</p>
                }
                <p class="mb-2">
                    @if (reviews.Count > 0)
                    {
                        <span class="stars" style="--rating:@reviews.Average.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"></span>
                        <span class="text-muted">@reviews.Average.ToString("0.0") / 5 (@reviews.Count đánh giá)</span>
                    }
                    else
                    {
                        <span class="text-muted">Chưa có đánh giá</span>
                    }
                </p>
                <p class="mb-3">
                    @if (Model.Quantity > 0)
                    {
                        <span class="badge bg-success">Còn @Model.Quantity quyển</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Đã hết sách</span>
                    }
                </p>

                @if (Model.Quantity > 0)
                {
                    <button type="button" class="btn btn-primary js-add-cart" data-id="@Model.Id" disabled="@inCart">
                        <i class="bi bi-basket"></i> @(inCart ? "Sách đã có trong giỏ" : "Thêm vào giỏ mượn")
                    </button>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />
                    <h5>Giới thiệu</h5>
                    @* Nội dung HTML từ editor: đã sanitize khi lưu và sanitize lại khi hiển thị (defense in depth) *@
                    <div>@Html.Raw(Sanitizer.Sanitize(Model.Description))</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-white"><h5 class="mb-0"><i class="bi bi-star-fill text-warning"></i> Đánh giá và bình luận</h5></div>
    <div class="card-body" id="reviews-box" data-book="@Model.Id">
        <partial name="_Reviews" model="reviews" />
    </div>
</div>

@if (recent.Any())
{
    <h5 class="mt-4">Sách bạn đã xem gần đây</h5>
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var b in recent)
        {
            <div class="col">
                <a href="/KhachHang/Details/@b?.Id" class="card h-100 text-decoration-none text-dark shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-book text-primary fs-3"></i>
                        <div class="fw-bold small mt-2">@b?.Title</div>
                        <div class="text-muted small">@b?.Author</div>
                    </div>
                </a>
            </div>
        }
    </div>
}
