@model PaginatedList<Book>
@{
    Layout = "_LayoutKhach";
    ViewData["Title"] = "Trang chủ";
    var categories = (List<CategoryCount>)ViewBag.Categories;
    string sort = ViewBag.Sort as string ?? "";
    string current = ViewBag.Category as string ?? "";
}

<section class="hero mb-4">
    <div class="hero-inner">
        <h1>Khám phá kho sách của chúng tôi</h1>
        <p class="lead mb-4">Tra cứu hàng nghìn đầu sách, mượn sách trực tuyến và chia sẻ cảm nhận của bạn.</p>

        <form id="filter-form" method="get" action="/KhachHang" class="row g-2">
            <input type="hidden" id="category-input" name="category" value="@current" />
            <div class="col-12 col-md-7">
                <input type="text" id="search-input" name="search" value="@ViewBag.Search" list="suggest" autocomplete="off"
                       class="form-control form-control-lg" placeholder="Nhập tên sách hoặc tác giả..." />
                <datalist id="suggest"></datalist>
            </div>
            <div class="col-7 col-md-3">
                <select name="sort" class="form-select form-select-lg">
                    <option value="" selected="@(sort == "")">Tên A → Z</option>
                    <option value="title_desc" selected="@(sort == "title_desc")">Tên Z → A</option>
                    <option value="newest" selected="@(sort == "newest")">Mới nhất</option>
                    <option value="available" selected="@(sort == "available")">Còn nhiều nhất</option>
                </select>
            </div>
            <div class="col-5 col-md-2 d-grid">
                <button type="submit" class="btn btn-warning btn-lg"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</section>

<div class="row g-4">
    <aside class="col-lg-3">
        <div class="card cat-card shadow-sm">
            <div class="card-header bg-white fw-bold"><i class="bi bi-tags text-primary"></i> Danh mục thể loại</div>
            <div class="list-group list-group-flush" id="category-list">
                <a class="list-group-item @(current == "" ? "active" : "")" data-category="">
                    <span><i class="bi bi-grid"></i> Tất cả</span>
                    <span class="badge bg-primary rounded-pill">@ViewBag.TotalBooks</span>
                </a>
                @foreach (var c in categories)
                {
                    <a class="list-group-item @(current == c.Name ? "active" : "")" data-category="@c.Name">
                        <span><i class="bi bi-bookmark"></i> @c.Name</span>
                        <span class="badge bg-secondary rounded-pill">@c.Count</span>
                    </a>
                }
            </div>
        </div>
    </aside>

    <div class="col-lg-9">
        <div id="list-container" data-url="/KhachHang" data-page="@Model.PageIndex">
            <partial name="_BookCards" model="Model" />
        </div>
    </div>
</div>
