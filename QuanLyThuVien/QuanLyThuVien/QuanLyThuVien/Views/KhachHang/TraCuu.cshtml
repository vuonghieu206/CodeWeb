@model QuanLyThuVien.Controllers.LookupViewModel
@{
    Layout = "_LayoutKhach";
    ViewData["Title"] = L["Tra cứu yêu cầu mượn"].Value;
    var records = ViewBag.Records as List<BorrowRecord>;
    string Badge(string s) => s switch
    {
        BorrowStatus.Pending => "bg-info text-dark",
        BorrowStatus.Borrowing => "bg-warning text-dark",
        BorrowStatus.Returned => "bg-success",
        BorrowStatus.Rejected => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<h3 class="mb-2"><i class="bi bi-clipboard-check"></i> @L["Tra cứu yêu cầu mượn"]</h3>
<p class="text-muted">@L["Nhập họ tên và số điện thoại đã dùng khi gửi yêu cầu để xem trạng thái."]</p>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="TraCuu" method="post" class="row g-2">
            <div class="col-12 col-md-5">
                <label asp-for="FullName" class="form-label">@L["Họ và tên"]</label>
                <input asp-for="FullName" class="form-control" maxlength="100" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Phone" class="form-label">@L["Số điện thoại"]</label>
                <input asp-for="Phone" class="form-control" inputmode="tel" placeholder="0912345678" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> @L["Tra cứu"]</button>
            </div>
        </form>
    </div>
</div>

@if (records != null)
{
    @if (!records.Any())
    {
        <div class="alert alert-warning">@L["Không tìm thấy yêu cầu nào khớp với thông tin đã nhập."]</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@L["Sách"]</th>
                            <th>@L["Ngày mượn"]</th>
                            <th>@L["Hạn trả"]</th>
                            <th>@L["Ngày trả"]</th>
                            <th>@L["Trạng thái"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in records)
                        {
                            <tr>
                                <td>@r.BookName</td>
                                <td>@r.BorrowDate.ToString("dd/MM/yyyy")</td>
                                <td>@(r.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(r.ReturnDate?.ToString("dd/MM/yyyy") ?? L["Chưa trả"].Value)</td>
                                <td><span class="badge @Badge(r.Status)">@L[r.Status]</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
