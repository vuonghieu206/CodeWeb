@model ReviewsViewModel
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var myRating = Model.Mine?.Rating ?? 0;
}
<div id="reviews-inner">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="text-center p-3 bg-light rounded-3">
                <div class="display-5 fw-bold">@(Model.Count == 0 ? "-" : Model.Average.ToString("0.0"))</div>
                <div><span class="stars" style="--rating:@Model.Average.ToString("0.0", inv)"></span></div>
                <div class="text-muted small">@Model.Count đánh giá</div>
            </div>

            <div class="mt-3">
                @if (Model.IsReader)
                {
                    <form id="reviewForm" data-book="@Model.Book.Id" novalidate>
                        <label class="form-label fw-bold">@(Model.Mine == null ? "Đánh giá của bạn" : "Cập nhật đánh giá của bạn")</label>
                        <div class="star-picker mb-1" data-value="@myRating">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <button type="button" class="star-btn @(i <= myRating ? "on" : "")" data-value="@i" aria-label="@i sao">★</button>
                            }
                        </div>
                        <input type="hidden" name="rating" id="ratingInput" value="@myRating" />
                        <textarea name="comment" class="form-control mb-2" rows="3" maxlength="1000"
                                  placeholder="Chia sẻ cảm nhận của bạn về cuốn sách...">@Model.Mine?.Comment</textarea>
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send"></i> @(Model.Mine == null ? "Gửi đánh giá" : "Cập nhật đánh giá")</button>
                    </form>
                }
                else if (Model.IsAuthenticated)
                {
                    <div class="alert alert-secondary small mb-0">Tài khoản quản trị không đánh giá sách. Hãy dùng tài khoản độc giả.</div>
                }
                else
                {
                    <div class="alert alert-info small mb-0">
                        Hãy <a href="#" class="js-open-login fw-bold">đăng nhập</a> để đánh giá cuốn sách này.
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8">
            @if (!Model.Reviews.Items.Any())
            {
                <div class="text-muted text-center py-4">Chưa có đánh giá nào. Hãy là người đầu tiên!</div>
            }
            @foreach (var r in Model.Reviews.Items)
            {
                <div class="review-item d-flex gap-3">
                    <div class="review-avatar">@(string.IsNullOrEmpty(r.UserName) ? "?" : r.UserName.Substring(0, 1).ToUpper())</div>
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap justify-content-between">
                            <strong>@r.UserName</strong>
                            <span class="text-muted small"><i class="bi bi-clock"></i> @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <span class="stars" style="--rating:@r.Rating"></span>
                        @if (!string.IsNullOrEmpty(r.Comment))
                        {
                            <div class="review-text mt-1">@r.Comment</div>
                        }
                    </div>
                </div>
            }
            <partial name="_Pager" model="Model.Reviews" />
        </div>
    </div>
</div>
